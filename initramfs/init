#!/bin/busybox sh
# Copyright (C) 2026 Chokri Hammedi (blue0x1) <https://github.com/blue0x1>
# Kali-PS4 initramfs: find the Kali root partition, mount it, hand over to systemd.
#
# Kernel cmdline options (all optional):
#   kali_root=<spec>     root to boot; LABEL=, UUID= or /dev/... (default LABEL=KALI-PS4)
#   kali_rootwait=<sec>  how long to wait for the USB drive (default 30)
#   kali_rescue          open a shell before mounting root

/bin/busybox --install -s /bin
export PATH=/bin

mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys

root_spec="LABEL=KALI-PS4"
rootwait=30
rescue=0
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        kali_root=*)     root_spec="${arg#kali_root=}" ;;
        kali_rootwait=*) rootwait="${arg#kali_rootwait=}" ;;
        kali_rescue)     rescue=1 ;;
    esac
done

msg() { echo "kali-ps4: $*"; echo "kali-ps4: $*" > /dev/kmsg 2>/dev/null; }

# Writes the kernel log to the FAT32 boot partition (LABEL=PS4BOOT) so a boot
# with no display or network can still be diagnosed on another computer.
save_log() {
    bd="$(findfs LABEL=PS4BOOT 2>/dev/null)" || return 0
    mkdir -p /bootfs
    mount -t vfat "$bd" /bootfs 2>/dev/null || return 0
    {
        echo "== kali-ps4 initramfs log: $1"
        echo "uptime: $(cut -d' ' -f1 /proc/uptime)s"
        echo "cmdline: $(cat /proc/cmdline)"
        uname -a
        echo "== /sys/class/drm"; ls /sys/class/drm 2>&1
        echo "== dmesg"; dmesg
    } > "/bootfs/kali-ps4-$2.log" 2>&1
    sync
    umount /bootfs
}

rescue_shell() {
    [ -x /bin/fbui ] && fbui text
    msg "$1"
    save_log "$1" rescue
    msg "rescue shell - mount the root on /newroot by hand, or type 'exit' to retry"
    setsid cttyhack sh || sh
}

resolve_root() {
    case "$root_spec" in
        /dev/*) [ -b "$root_spec" ] && echo "$root_spec" ;;
        *)      findfs "$root_spec" 2>/dev/null ;;
    esac
}

# --- First-boot screens (fbui.c) --------------------------------------------
UI_IMG=/etc/kali-ps4/logo.rgba
ui_asked=0
img_created=0

# First USB disk of at least 8 GB that is not the PS4's own drive (the one
# with partition 27). Sets usb_dev (/dev/sdX) and usb_desc ("Model, 64 GB").
usb_dev=""
usb_desc=""
find_usb_disk() {
    for b in /sys/block/sd*; do
        [ -e "$b/size" ] || continue
        n="${b##*/}"
        [ -e "$b/${n}27" ] && continue
        case "$(readlink -f "$b")" in */usb*) ;; *) continue ;; esac
        gb=$(( $(cat "$b/size") / 2097152 ))
        [ "$gb" -ge 8 ] || continue
        model="$(cat "$b/device/vendor" "$b/device/model" 2>/dev/null | tr -s ' \n' ' ')"
        model="${model% }"; model="${model# }"
        usb_dev="/dev/$n"
        usb_desc="${model:-USB drive}, $gb GB"
        return 0
    done
    return 1
}

# Reboot button: leave the installer without writing anything. The PS4 drive
# is only mounted read-only at this point.
ui_reboot() {
    msg "First boot: reboot chosen, nothing installed"
    fbui msg "$UI_IMG" "Restarting the PS4..."
    umount /ps4hdd 2>/dev/null
    cryptsetup --disable-locks remove ps4hdd 2>/dev/null
    sync
    sleep 2
    reboot -f
}

# Install screen. Sets install_target to hdd (the PS4 drive) or usb. With a
# USB drive connected the user can choose it (after an erase confirmation);
# with no input for 60 s it installs to the PS4 drive.
install_target=hdd
ui_welcome() {
    [ "$ui_asked" = 1 ] && return 0
    ui_asked=1
    [ "$1" = nousb ] || find_usb_disk
    msg "First boot: waiting for the Install button${usb_dev:+ (USB drive $usb_dev: $usb_desc)}"
    if [ -x /bin/fbui ]; then
        fbui welcome "$UI_IMG" "$usb_desc"
        case $? in
            10) [ -n "$usb_dev" ] && install_target=usb ;;
            20) ui_reboot ;;
        esac
    fi
    msg "First boot: installing to $install_target"
}

# stdin -> stdout with the progress bar: FROM% TO% SIZE LABEL
ui_progress() {
    if [ -x /bin/fbui ]; then fbui progress "$UI_IMG" "$@"; else cat; fi
}

ui_step() { ui_progress "$1" "$1" 1 "$2" < /dev/null > /dev/null; }

# "Still working" screen (full bar, spinning arc) while data is flushed to
# the drive, which can take minutes on a slow USB stick.
busy_pid=""
ui_busy() {
    [ -x /bin/fbui ] || return 0
    fbui busy "$UI_IMG" "$1" &
    busy_pid=$!
}

ui_busy_end() {
    [ -n "$busy_pid" ] || return 0
    kill "$busy_pid" 2>/dev/null
    wait "$busy_pid" 2>/dev/null
    busy_pid=""
}

ui_error() {
    msg "$1"
    [ -x /bin/fbui ] || return 0
    fbui error "$UI_IMG" "$1"
    sleep 10
    fbui text
}
# ----------------------------------------------------------------------------

# --- Internal drive boot ----------------------------------------------------
# Boots kali-ps4.img (an ext4 image) stored on the PS4's own drive at
# /user/home/kali-ps4.img (uploaded with the PS4's FTP, so the PS4 created the
# file). The PS4 user partition is unlocked with the console key that
# ps4-linux-loader provides, mounted READ-ONLY only to map the image's blocks,
# then unmounted: Linux never writes the PS4's filesystem, only inside the file.
HDD_IMG=home/kali-ps4.img
HDD_TAR=home/kali-ps4-rootfs.tar.xz

# First boot: kali-ps4.img is a new, all-zero file (created on the PS4 side)
# and kali-ps4-rootfs.tar.xz sits next to it. Format the image and unpack
# Kali into it. Anything that is not all zeros is left alone.
first_boot_install() {
    if [ -n "$(dd if=/dev/mapper/kaliimg bs=1M count=1 2>/dev/null | hexdump -v -e '/1 "%02x"' | tr -d 0)" ]; then
        msg "hdd: /user/$HDD_IMG is neither ext4 nor empty; refusing to touch it"
        return 1
    fi
    if [ -z "$tar_size" ] || ! [ -b /dev/mapper/kalitar ]; then
        msg "hdd: /user/$HDD_IMG is empty and /user/$HDD_TAR is missing; nothing to install"
        return 1
    fi
    [ -x /bin/mke2fs ] || { msg "hdd: mke2fs missing in initramfs"; return 1; }

    ui_welcome nousb
    from=0; [ "$img_created" = 1 ] && from=25
    msg "First boot: installing Kali into /user/$HDD_IMG (about 10 minutes, do not turn off)"
    ui_step "$from" "Preparing the Kali disk"
    /bin/mke2fs -q -F -t ext4 -L KALI-PS4 -m 1 /dev/mapper/kaliimg > /dev/kmsg 2>&1 \
        || { ui_error "Installation failed: could not format the Kali disk"; return 1; }
    mount -t ext4 /dev/mapper/kaliimg /newroot \
        || { ui_error "Installation failed: could not mount the Kali disk"; return 1; }

    if head -c "$tar_size" /dev/mapper/kalitar | ui_progress "$from" 100 "$tar_size" "Installing Kali Linux" \
       | xz -dc | tar -x -C /newroot && [ -e /newroot/usr/lib/systemd/systemd ]; then
        ui_busy "Finishing: writing data to the PS4 drive..."
        sync
        msg "First boot: Kali installed ($(du -sm /newroot | cut -f1) MB). Starting Kali."
        ui_busy_end
        [ -x /bin/fbui ] && fbui done "$UI_IMG" "Kali Linux is installed. Starting..." && sleep 3
        return 0
    fi
    umount /newroot
    ui_error "Installation failed: could not unpack /user/$HDD_TAR"
    return 1
}

# First boot, step 1: only the archive was copied to the PS4. Create the
# image file once (16 GiB, or less if space is short; at least 8 GiB, always
# leaving 10 GiB free for the PS4). This is the only time Linux writes the
# PS4's filesystem: one new, fully allocated file. Then it is read-only again.
HDD_IMG_MB=16384
HDD_MIN_MB=8192
HDD_KEEP_FREE_MB=10240

create_image() {
    free_mb=$(df -m /ps4hdd | awk 'NR==2{print $4}')
    size_mb=$HDD_IMG_MB
    avail=$(( ${free_mb:-0} - HDD_KEEP_FREE_MB ))
    [ "$avail" -lt "$size_mb" ] && size_mb=$avail
    if [ "$size_mb" -lt "$HDD_MIN_MB" ]; then
        ui_welcome
        ui_error "Not enough free space on the PS4: ${free_mb:-?} MB free, $((HDD_MIN_MB + HDD_KEEP_FREE_MB)) MB needed"
        return 1
    fi
    # Nothing is written to the PS4 drive before the Install button.
    ui_welcome
    if ! mount -o remount,rw /ps4hdd; then
        ui_error "Installation failed: could not open the PS4 drive for writing"
        return 1
    fi
    msg "First boot: creating /user/$HDD_IMG ($((size_mb / 1024)) GB, a few minutes, do not turn off)"
    bytes=$((size_mb * 1048576))
    if head -c "$bytes" /dev/zero | ui_progress 0 25 "$bytes" "Creating the Kali disk on your PS4" \
           > "/ps4hdd/$HDD_IMG" && sync && [ "$(stat -c %s "/ps4hdd/$HDD_IMG")" = "$bytes" ]; then
        mount -o remount,ro /ps4hdd
        img_created=1
        msg "First boot: image created"
        return 0
    fi
    ui_error "Installation failed: could not create the Kali disk"
    msg "First boot: removing the partial file"
    rm -f "/ps4hdd/$HDD_IMG"
    sync
    mount -o remount,ro /ps4hdd
    return 1
}

# Installs Kali from /user/$HDD_TAR (on the PS4 drive, mounted read-only on
# /ps4hdd) onto the whole USB drive $usb_dev, erasing it. Later boots find
# it by its label (KALI-PS4) before looking at the PS4 drive.
usb_install() {
    tsize=$(stat -c %s "/ps4hdd/$HDD_TAR")
    mkdir -p /run
    if ! blockmap "/ps4hdd/$HDD_TAR" /dev/mapper/ps4hdd > /run/kali-tar.table; then
        umount /ps4hdd; cryptsetup --disable-locks remove ps4hdd
        ui_error "Installation failed: could not read /user/$HDD_TAR"
        return 1
    fi
    umount /ps4hdd
    if ! dmsetup --noudevsync create kalitar < /run/kali-tar.table > /dev/kmsg 2>&1; then
        cryptsetup --disable-locks remove ps4hdd
        ui_error "Installation failed: could not read /user/$HDD_TAR"
        return 1
    fi

    ok=0
    msg "First boot: installing Kali onto $usb_dev ($usb_desc)"
    ui_step 0 "Preparing the USB drive"
    # Old partition tables (at the start, and the GPT copy at the end) would
    # hide the new filesystem, so clear both before formatting the whole disk.
    sectors=$(cat "/sys/block/${usb_dev#/dev/}/size")
    dd if=/dev/zero of="$usb_dev" bs=1M count=4 conv=fsync 2>/dev/null
    dd if=/dev/zero of="$usb_dev" bs=512 seek=$((sectors - 8192)) count=8192 conv=fsync 2>/dev/null
    if ! /bin/mke2fs -q -F -t ext4 -L KALI-PS4 -m 1 "$usb_dev" > /dev/kmsg 2>&1; then
        ui_error "Installation failed: could not format the USB drive"
    elif ! mount -t ext4 "$usb_dev" /newroot; then
        ui_error "Installation failed: could not mount the USB drive"
    elif head -c "$tsize" /dev/mapper/kalitar \
            | ui_progress 0 100 "$tsize" "Installing Kali Linux onto the USB drive" \
            | xz -dc | tar -x -C /newroot && [ -e /newroot/usr/lib/systemd/systemd ]; then
        ui_busy "Finishing: writing data to the USB drive..."
        sync
        ok=1
        msg "First boot: Kali installed on $usb_dev ($(du -sm /newroot | cut -f1) MB). Starting Kali."
        ui_busy_end
        [ -x /bin/fbui ] && fbui done "$UI_IMG" "Kali Linux is installed on the USB drive. Starting..." && sleep 3
    else
        umount /newroot
        ui_error "Installation failed: could not unpack /user/$HDD_TAR"
    fi
    dmsetup --noudevsync remove kalitar
    cryptsetup --disable-locks remove ps4hdd
    [ "$ok" = 1 ]
}

hdd_boot() {
    [ -r /key/eap_hdd_key.bin ] || { msg "hdd: loader gave no drive key"; return 1; }
    for t in cryptsetup dmsetup blockmap; do
        [ -x "/bin/$t" ] || { msg "hdd: $t missing in initramfs"; return 1; }
    done
    export DM_DISABLE_UDEV=1

    part=""; i=0
    while [ "$i" -lt 15 ] && [ -z "$part" ]; do
        for p in /dev/sd?27; do [ -b "$p" ] && part="$p" && break; done
        [ -n "$part" ] || { sleep 1; i=$((i + 1)); }
    done
    [ -n "$part" ] || { msg "hdd: PS4 user partition (sdX27) not found"; return 1; }

    # Aeolia (CUH-10xx/11xx) uses no IV offset; Belize and Baikal mix in the
    # partition position (same values as the community internal-HDD initramfs).
    skip=111669149696
    [ "$(cat /sys/bus/pci/devices/0000:00:14.0/device 2>/dev/null)" = 0x908f ] && skip=0
    cryptsetup --disable-locks -d /key/eap_hdd_key.bin --cipher aes-xts-plain64 -s 256 \
        --offset 0 --skip "$skip" create ps4hdd "$part" > /dev/kmsg 2>&1 \
        || { msg "hdd: could not unlock $part"; return 1; }

    mkdir -p /ps4hdd
    if ! mount -t ufs -o ro,ufstype=ufs2 /dev/mapper/ps4hdd /ps4hdd; then
        msg "hdd: could not mount PS4 user partition (read-only)"
        cryptsetup --disable-locks remove ps4hdd
        return 1
    fi
    if [ ! -f "/ps4hdd/$HDD_IMG" ]; then
        if [ ! -f "/ps4hdd/$HDD_TAR" ]; then
            msg "hdd: no /user/$HDD_IMG or /user/$HDD_TAR on the PS4 drive"
            umount /ps4hdd; cryptsetup --disable-locks remove ps4hdd
            return 1
        fi
        ui_welcome
        if [ "$install_target" = usb ]; then
            usb_install
            return $?
        fi
        create_image || {
            umount /ps4hdd; cryptsetup --disable-locks remove ps4hdd
            return 1
        }
    fi
    mkdir -p /run
    if ! blockmap "/ps4hdd/$HDD_IMG" /dev/mapper/ps4hdd > /run/kali-img.table; then
        msg "hdd: could not map /user/$HDD_IMG (holes or unsupported)"
        umount /ps4hdd; cryptsetup --disable-locks remove ps4hdd
        return 1
    fi
    msg "hdd: image mapped in $(wc -l < /run/kali-img.table) extents"
    # The archive is mapped the same way, so the PS4 filesystem can be
    # unmounted before either mapping is created (the device-mapper cannot
    # use the partition while it is mounted).
    tar_size=""
    if [ -f "/ps4hdd/$HDD_TAR" ] && blockmap "/ps4hdd/$HDD_TAR" /dev/mapper/ps4hdd > /run/kali-tar.table; then
        tar_size=$(stat -c %s "/ps4hdd/$HDD_TAR")
    fi
    # Done with the PS4 filesystem (read-only the whole time).
    umount /ps4hdd
    msg "hdd: PS4 filesystem unmounted"

    if ! dmsetup --noudevsync create kaliimg < /run/kali-img.table > /dev/kmsg 2>&1; then
        msg "hdd: dmsetup failed"
        cryptsetup --disable-locks remove ps4hdd
        return 1
    fi
    if [ -n "$tar_size" ] && ! dmsetup --noudevsync create kalitar < /run/kali-tar.table > /dev/kmsg 2>&1; then
        tar_size=""
    fi
    magic="$(dd if=/dev/mapper/kaliimg bs=1 skip=1080 count=2 2>/dev/null | hexdump -v -e '/1 "%02x"')"
    installed=0
    if [ "$magic" != 53ef ]; then
        first_boot_install || {
            [ -b /dev/mapper/kalitar ] && dmsetup --noudevsync remove kalitar
            dmsetup --noudevsync remove kaliimg; cryptsetup --disable-locks remove ps4hdd
            return 1
        }
        installed=1
    fi
    [ -b /dev/mapper/kalitar ] && dmsetup --noudevsync remove kalitar

    if [ "$installed" = 0 ]; then
        /bin/e2fsck -p /dev/mapper/kaliimg > /dev/kmsg 2>&1
        msg "hdd: e2fsck exit code $?"
        mount -t ext4 /dev/mapper/kaliimg /newroot || true
    fi
    if ! grep -q ' /newroot ' /proc/mounts || [ ! -e /newroot/usr/lib/systemd/systemd ]; then
        msg "hdd: image does not contain Kali"
        umount /newroot 2>/dev/null
        dmsetup --noudevsync remove kaliimg; cryptsetup --disable-locks remove ps4hdd
        return 1
    fi
    msg "hdd: booting Kali from the PS4 internal drive"
    return 0
}
# ----------------------------------------------------------------------------

# A USB hard drive can take several seconds to spin up and appear.
[ "$rootwait" = 30 ] && [ -r /key/eap_hdd_key.bin ] && rootwait=10

# Boot screen: round avatar near the top, credits under it, and the boot
# messages scrolling in the region below so they never cover the image.
show_banner() {
    [ -x /bin/splash ] && [ -f /etc/kali-ps4/splash.rgb ] || return 0
    i=0
    while [ ! -e /dev/fb0 ] && [ "$i" -lt 10 ]; do sleep 1; i=$((i + 1)); done
    [ -e /dev/fb0 ] || return 0
    echo 1 > /proc/sys/kernel/printk          # keep kernel messages off the screen
    rows=$(cut -d, -f2 /sys/class/graphics/fb0/virtual_size 2>/dev/null)
    rows=$(( ${rows:-1080} / 16 ))            # 8x16 console font
    cols=$(( $(cut -d, -f1 /sys/class/graphics/fb0/virtual_size 2>/dev/null || echo 1920) / 8 ))
    printf '\033[2J\033[H\033[?25l' > /dev/console
    splash /etc/kali-ps4/splash.rgb 8
    # Logo ends at 8% + 270 px; text starts two rows under it.
    top=$(( (rows * 8 / 100) + 270 / 16 + 2 ))
    for line in "Kali Linux for PS4" "Credits: blue0x1"; do
        pad=$(( (cols - ${#line}) / 2 )); [ "$pad" -gt 0 ] || pad=0
        printf '\033[%d;%dH%s' "$top" "$((pad + 1))" "$line" > /dev/console
        top=$((top + 1))
    done
    printf '\033[%d;%dr\033[%d;1H' "$((top + 2))" "$rows" "$((top + 2))" > /dev/console
}
# Keep the Slim/Pro HDMI bridge output on during the initramfs (boot screen,
# first-boot progress). Kali's ps4-hdmi-keepalive takes over after the switch.
hdmi_pid=""
if [ -x /bin/ps4hdmi ]; then
    ps4hdmi & hdmi_pid=$!
fi
show_banner

msg "initramfs starting, looking for $root_spec"
[ "$rescue" = 1 ] && rescue_shell "rescue shell requested"

while :; do
    grep -q ' /newroot ' /proc/mounts && break

    dev=""
    i=0
    while [ "$i" -lt "$rootwait" ]; do
        dev="$(resolve_root)" && [ -n "$dev" ] && break
        sleep 1
        i=$((i + 1))
    done

    if [ -z "$dev" ]; then
        msg "no USB root after ${rootwait}s, trying the PS4 internal drive"
        hdd_boot && break
        rescue_shell "root $root_spec not found after ${rootwait}s"
        continue
    fi

    msg "mounting $dev"
    # Hard power-offs leave the journal dirty; repair before mounting.
    if [ -x /bin/e2fsck ]; then
        save_log "root found, running e2fsck" prefsck
        /bin/e2fsck -p "$dev" > /dev/kmsg 2>&1
        msg "e2fsck exit code $?"
    fi
    if ! mount -o ro "$dev" /newroot; then
        rescue_shell "could not mount $dev"
        continue
    fi
    if [ ! -e /newroot/usr/lib/systemd/systemd ]; then
        umount /newroot
        rescue_shell "$dev does not contain a Kali-PS4 root filesystem"
    fi
done

# ps4-linux-loader put this console's own GPU firmware (and its TV's EDID)
# into the initramfs. If amdgpu is a module it loads after the switch, so give
# Kali a copy on tmpfs over its firmware folders.
for fw in amdgpu edid; do
    if [ -d "/lib/firmware/$fw" ] && [ -d "/newroot/usr/lib/firmware" ]; then
        mkdir -p /fwcopy
        mount -t tmpfs -o mode=0755 tmpfs /fwcopy
        cp -a "/newroot/usr/lib/firmware/$fw/." /fwcopy/ 2>/dev/null
        cp -a "/lib/firmware/$fw/." /fwcopy/
        if [ -d "/newroot/usr/lib/firmware/$fw" ]; then
            mount --move /fwcopy "/newroot/usr/lib/firmware/$fw"
            msg "copied loader firmware: $fw ($(ls /newroot/usr/lib/firmware/$fw | wc -l) files)"
        else
            umount /fwcopy
            msg "no /usr/lib/firmware/$fw in Kali to cover; skipped"
        fi
    fi
done

msg "switching to Kali"
save_log "root mounted, switching to Kali" boot

# Keep copying the kernel log to PS4BOOT for 3 minutes after Kali starts, so
# problems after the handover can be read later. switch_root deletes this
# initramfs (including busybox), so run a copy of busybox from the FAT32
# partition, which switch_root leaves mounted.
if bd="$(findfs LABEL=PS4BOOT 2>/dev/null)" && mkdir -p /bootfs && mount -t vfat "$bd" /bootfs 2>/dev/null \
   && cp /bin/busybox /bootfs/busybox 2>/dev/null; then
    (
        bb=/bootfs/busybox
        i=0
        while [ "$i" -lt 36 ]; do
            $bb sleep 5
            $bb dmesg > /bootfs/kali-ps4-late.log 2>&1
            $bb sync
            i=$((i + 1))
        done
    ) </dev/null >/dev/null 2>&1 &
fi

[ -x /bin/fbui ] && fbui text
printf '\033[r\033[?25h' > /dev/console 2>/dev/null   # undo the boot-screen scroll region
[ -n "$hdmi_pid" ] && kill "$hdmi_pid" 2>/dev/null
umount /proc /sys
mount --move /dev /newroot/dev
exec switch_root /newroot /sbin/init
